{
  "name": "maple-web",
  "version": "1.0.0",
  "description": "Maple Web - Custom Chromium Browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "org.davin.mapleweb",
    "productName": "org.davin.mapleweb",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "category": "Network"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
